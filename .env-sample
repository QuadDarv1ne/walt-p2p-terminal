# Walt P2P Terminal — локальные переменные окружения
# Скопируйте этот файл в .env и укажите свои значения.
# .env не должен попадать в Git.

# Основной URL P2P API (Walt)
NEXT_PUBLIC_P2P_API_URL=https://p2p.walletbot.me/p2p/integration-api/v1/item/online

# API-ключ Walt — только для серверных частей (релей).
# ВАЖНО: имя без префикса NEXT_PUBLIC_ — иначе Next.js вкомпилирует ключ
# в клиентский бандл, и он станет доступен любому посетителю.
# При пустом поле терминал попросит ввести ключ в настройках.
P2P_API_KEY=
